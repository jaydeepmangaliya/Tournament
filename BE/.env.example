# ==============================================================================
# LocalEsport Production Environment Configuration Template
# Copy this file to BE/.env and fill in your values
# ==============================================================================

# 1. AWS RDS MySQL Database Configuration
DB_HOST=localesport-db.c9k2a8b.ap-south-1.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=your_master_rds_password
DB_NAME=tournament
DB_PORT=3306

# 2. JWT Authentication Secrets (Generate secure random strings)
JWT_SECRET_KEY=replace_with_a_secure_random_64_character_string
JWT_SECRET=replace_with_a_secure_random_64_character_string

# 3. Razorpay Payment Gateway Credentials (Use LIVE keys for production)
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# 4. Server & Domain Settings
PORT=2000
NODE_ENV=production
CLIENT_URL=https://yourdomain.com
